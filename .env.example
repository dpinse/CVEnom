# CVEnom configuration. Copy to .env (never commit it) and fill in the blanks.
# Secrets are intentionally blank here.

# --- Compose-level secrets (used by deploy/docker-compose.prod.yml) ---
# DB and Redis passwords MUST be URL-safe (compose builds URLs without escaping):
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=

# --- Required in production (DATABASE_URL / REDIS_URL are built by compose) ---
# DATABASE_URL=postgresql+psycopg://cvenom_app:PASSWORD@postgres:5432/cvenom
# REDIS_URL=redis://:PASSWORD@redis:6379/0
# AES-256 key for stored webhook secrets/URLs and JWT private keys.
# generate: openssl rand -base64 32
SECRETS_KEY=
# The API refuses to start when SECRETS_KEY is missing or invalid (keep true).
REQUIRE_SECRETS_KEY=true
# The first admin's password is NOT kept here: export it in your shell and pass
# `-e ADMIN_PASSWORD` on the one `create-admin` run (see docs/deploy.md).

# --- API exposure ---
# Anonymous read-only access to the radar data.
PUBLIC_READ=true
# Interactive API docs (/docs, /redoc). Keep off in production.
API_DOCS=false
# Exact browser origins allowed by CORS, JSON list. Empty = same-origin only.
# CORS_ORIGINS='["https://cvenom.example.com"]'
# CIDRs of proxies whose X-Forwarded-For is trusted (JSON list). The chain is cloudflared on
# the host -> bridge gateway 172.28.0.1 -> frontend nginx 172.28.0.10 -> api. The api sees
# nginx as its peer, and nginx appends the gateway to X-Forwarded-For, so BOTH are trusted hops.
# (127.0.0.1 would be wrong: the host reaches nginx through the bridge gateway.)
TRUSTED_PROXY_CIDRS='["172.28.0.1/32","172.28.0.10/32"]'
# Leave false with the bundled nginx: it clears any CF-Connecting-IP before proxying, so the
# header never reaches the api. (uvicorn --proxy-headers also resolves the peer from
# X-Forwarded-For first; see docs/deploy.md.)
TRUST_CF_CONNECTING_IP=false
# uvicorn --forwarded-allow-ips (must match the proxies that connect to the container).
# Defaults to the gateway and nginx, 172.28.0.1,172.28.0.10, in compose.
# FORWARDED_ALLOW_IPS=172.28.0.1,172.28.0.10
# WORKER_CONCURRENCY=2

# --- Auth ---
JWT_ISSUER=cvenom
JWT_AUDIENCE=cvenom-api
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
# Signing keys rotate automatically on this schedule.
JWT_ROTATION_DAYS=7

# --- Limits ---
MAX_BODY_BYTES=65536
RATE_ANON_PER_MIN=60
RATE_AUTHED_PER_MIN=300
RATE_ALERT_TEST_PER_MIN=5
RATE_LOGIN_PER_15MIN_IP=10
RATE_LOGIN_PER_15MIN_EMAIL=10

# --- Email alerts (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDR=
SMTP_STARTTLS=true

# --- Data source API keys (blank = that source is skipped, or runs unauthenticated where it supports that) ---
# NVD: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# VulnCheck community: https://vulncheck.com/community
VULNCHECK_API_TOKEN=
# GitHub personal access token, no scopes needed: https://github.com/settings/tokens
GITHUB_TOKEN=
# MaxMind GeoLite2: https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# ransomware.live Pro API key (paid). The ransomware collector is OFF while this is blank.
# Polls hourly, per their fair-use policy.
RANSOMWARE_LIVE_API_KEY=
# Cloudflare Radar (the Radar collector is OFF while blank): https://dash.cloudflare.com/profile/api-tokens
CF_RADAR_TOKEN=
# abuse.ch Auth-Key (the ThreatFox collector is OFF while blank; DShield and Feodo need no key): https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# --- Scoring / ingestion tuning ---
EPSS_PERCENTILE_THRESHOLD=0.95
FRESH_CVSS_FLOOR=9.0
FRESH_WINDOW_HOURS=48
LOUD_WINDOW_HOURS=72
VELOCITY_WINDOW_DAYS=30
BACKFILL_DAYS=90
KEV_ALERT_MAX_AGE_DAYS=14
GEO_RETENTION_DAYS=30
# Set by compose in production; local default is data/geoip.
# GEOIP_DIR=/data/geoip

# CVEnom dev environment. Copy to .env.dev (untracked; never commit it):
#   cp .env.dev.example .env.dev
# These are throwaway local values for docker-compose.dev.yml only. Never reuse production secrets.
# Compose overrides DATABASE_URL / REDIS_URL for the containers, so only the keys below matter.

# Host ports for the dev stack (always bound to 127.0.0.1). Defaults apply when unset. To change
# them (e.g. another Postgres already uses 5432) start with:
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up
DEV_PG_PORT=5432
DEV_REDIS_PORT=6379
DEV_API_PORT=8000
DEV_FRONTEND_PORT=5173

# Needed to run backend code on the host (host-only workflow); the containers ignore these.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/cvenom
REDIS_URL=redis://127.0.0.1:6379/0

# Optional: AES-256 key for stored webhook secrets. generate: openssl rand -base64 32
SECRETS_KEY=
REQUIRE_SECRETS_KEY=false
PUBLIC_READ=true
API_DOCS=true

# Optional collector keys; collectors without a key skip.
NVD_API_KEY=
VULNCHECK_API_TOKEN=
GITHUB_TOKEN=
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
RANSOMWARE_LIVE_API_KEY=
CF_RADAR_TOKEN=
ABUSECH_AUTH_KEY=
